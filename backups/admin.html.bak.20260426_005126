// ==================== Actions ====================
function toggleAll(type, checkbox) {
    const table = document.getElementById(type + 'Table');
    if (!table) return;
    table.querySelectorAll('tbody input[type="checkbox"]').forEach(cb => {
        cb.checked = checkbox.checked;
        toggleSelect(type, parseInt(cb.value), cb);
    });
}

function toggleSelect(type, id, checkbox) {
    const set = state['selected' + type.charAt(0).toUpperCase() + type.slice(1)];
    if (checkbox.checked) set.add(id); else set.delete(id);
    updateBulkBar(type);
}

function updateBulkBar(type) {
    const set = state['selected' + type.charAt(0).toUpperCase() + type.slice(1)];
    const bar = document.getElementById(type + 'BulkBar');
    const count = document.getElementById(type + 'BulkCount');
    if (!bar || !count) return;
    count.textContent = set.size + ' محدد';
    bar.classList.toggle('show', set.size > 0);
}

function bulkAction(action) {
    alert(`تم ${action} للمستخدمين المحددين (${state.selectedUsers.size})`);
    state.selectedUsers.clear();
    updateBulkBar('user');
}

