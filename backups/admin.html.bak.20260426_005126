            <div class="stat-card"><div class="stat-number">567</div><div class="stat-label">📋 صفقات نشطة</div></div>
            <div class="stat-card"><div class="stat-number">$89K</div><div class="stat-label">💰 حجم التعاملات</div></div>
            <div class="stat-card"><div class="stat-number">23</div><div class="stat-label">⚠️ نزاعات مفتوحة</div></div>
