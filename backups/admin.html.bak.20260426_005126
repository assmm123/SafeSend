// ==================== Disputes ====================
function renderDisputes() {
    return `
        <div class="card mb-4"><h3>⚠️ إدارة النزاعات</h3></div>
        <div class="card" style="overflow-x:auto;">
            <table class="data-table">
                <thead><tr><th>#</th><th>الصفقة</th><th>من</th><th>ضد</th><th>السبب</th><th>الحالة</th><th>إجراءات</th></tr></thead>
                <tbody>
                    ${state.disputes.map(d => `<tr>
                        <td>${d.id}</td><td>${d.deal}</td><td>${d.from}</td><td>${d.against}</td><td>${d.reason}</td>
                        <td><span class="badge badge-warning">${d.status}</span></td>
                        <td class="actions">
                            <button class="btn btn-sm btn-primary" onclick="assignMediator(${d.id})">👤 وسيط</button>
                            <button class="btn btn-sm btn-outline" onclick="viewEvidence(${d.id})">📸 أدلة</button>
                            <button class="btn btn-sm btn-warning" onclick="freezeFunds(${d.id})">🧊 تجميد</button>
                            <button class="btn btn-sm btn-success" onclick="resolveDispute(${d.id})">✅ حل</button>
                        </td>
                    </tr>`).join('')}
                </tbody>
            </table>
        </div>`;
}

// ==================== Documents ====================
function renderDocuments() {
    return `
        <div class="card mb-4"><h3>📄 المستندات والسياسات</h3></div>
        ${Object.entries(state.documents).map(([key, doc]) => `
            <div class="card mb-3">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div><p class="fw-600">${doc.title}</p><p class="text-sm text-muted">آخر تحديث: ${doc.updated}</p></div>
                    <div class="actions">
                        <button class="btn btn-sm btn-outline" onclick="editDocument('${key}')">✏️ تعديل</button>
                        <button class="btn btn-sm btn-outline" onclick="viewDocument('${key}')">👁️ عرض</button>
                        <button class="btn btn-sm btn-primary" onclick="sendDocument('${key}')">📤 إرسال للمستخدمين</button>
                    </div>
                </div>
            </div>
        `).join('')}
        <button class="btn btn-primary" onclick="addDocument()">+ إضافة مستند جديد</button>`;
}

// ==================== Reports ====================
function renderReports() {
    const periods = ['يومي','أسبوعي','شهري','سنوي'];
    const reports = ['الإيرادات','المستخدمين الجدد','الصفقات','العمولات','النزاعات','ملخص شامل'];
    return `
        <div class="card mb-4"><h3>📈 التقارير</h3></div>
