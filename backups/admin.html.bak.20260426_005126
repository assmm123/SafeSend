// ==================== Tab Rendering ====================
function renderTab(tab) {
    const container = document.getElementById('adminContent');
    switch(tab) {
        case 'dashboard': container.innerHTML = renderDashboard(); initCharts(); break;
        case 'users': container.innerHTML = renderUsers(); break;
        case 'deals': container.innerHTML = renderDeals(); break;
        case 'payouts': container.innerHTML = renderPayouts(); break;
        case 'disputes': container.innerHTML = renderDisputes(); break;
        case 'documents': container.innerHTML = renderDocuments(); break;
        case 'reports': container.innerHTML = renderReports(); break;
        case 'alerts': container.innerHTML = renderAlerts(); break;
        case 'settings': container.innerHTML = renderSettings(); break;
        case 'system': container.innerHTML = renderSystem(); break;
        case 'audit': container.innerHTML = renderAudit(); break;
    }
}

// ==================== Dashboard ====================
