            </div>
        </div>`;
}

function initCharts() {
    setTimeout(() => {
        const charts = [
            { id:'revenueChart', type:'line', data:[120,250,180,300,450,320,500], labels:['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو'], color:'#1a73e8' },
            { id:'usersChart', type:'bar', data:[50,120,200,350,500,800,1234], labels:['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو'], color:'#0d904f' },
            { id:'dealsChart', type:'doughnut', data:[30,45,25,200,5], labels:['معلقة','نشطة','ممولة','مكتملة','نزاع'], color:null },
            { id:'disputesChart', type:'pie', data:[15,5,3], labels:['محلولة','قيد المراجعة','مستأنفة'], color:null },
        ];
        charts.forEach(c => {
            const ctx = document.getElementById(c.id);
            if (!ctx) return;
            new Chart(ctx.getContext('2d'), {
                type: c.type,
                data: {
                    labels: c.labels,
                    datasets: [{ data:c.data, backgroundColor:c.color ? c.color+'33' : ['#f5a623','#1a73e8','#0d904f','#64748b','#d93025'], borderColor:c.color || '#1a73e8', fill:c.type==='line', tension:0.4 }]
                },
                options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:c.type!=='line'&&c.type!=='bar', position:'bottom' } } }
            });
        });
    }, 100);
}

// ==================== Users ====================
