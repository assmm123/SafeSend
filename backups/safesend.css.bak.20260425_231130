    --radius-xl: 24px;
    --radius-full: 9999px;
    
    /* Typography */
    --font-family: 'Tajawal', 'Segoe UI', Tahoma, sans-serif;
    --font-mono: 'SF Mono', 'Cascadia Code', monospace;
    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 2rem;
    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --font-weight-extrabold: 800;
    
    /* Transitions */
    --transition-fast: 150ms ease;
    --transition: 250ms ease;
    --transition-slow: 350ms ease;
    
    /* Z-index */
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-modal: 300;
    --z-toast: 400;
    
    /* Layout */
    --sidebar-width: 260px;
    --header-height: 60px;
    --bottom-nav-height: 60px;
    --container-max: 1200px;
}

/* ============================================================
   🌙 Dark Mode
   ============================================================ */
[data-theme="dark"],
.dark-mode {
    --primary: #4a90d9;
    --primary-dark: #1a73e8;
    --primary-bg: #1a2a3a;
    --success: #2ea043;
    --success-bg: #1a2a1a;
    --danger: #f85149;
    --danger-bg: #2a1a1a;
    --warning: #d2991d;
    --warning-bg: #2a2a1a;
    
    --bg: #0d1117;
    --bg-secondary: #161b22;
    --surface: #1c2128;
    --surface-hover: #22282e;
    --border: #30363d;
    --border-light: #21262d;
    
    --text: #e6edf3;
    --text-secondary: #c9d1d9;
    --text-light: #8b949e;
    --text-muted: #6e7681;
    --text-inverse: #0d1117;
    
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
    --shadow: 0 1px 3px rgba(0,0,0,0.4);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.5);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.6);
    --shadow-xl: 0 20px 60px rgba(0,0,0,0.7);
}

/* ============================================================
   🔄 Reset & Base
   ============================================================ */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-normal);
    line-height: 1.6;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background var(--transition), color var(--transition);
}

/* ============================================================
   🌐 RTL / LTR Support
   ============================================================ */
[dir="rtl"] {
    direction: rtl;
    text-align: right;
}

[dir="ltr"] {
    direction: ltr;
    text-align: left;
}

/* RTL-aware margin/padding utilities */
[dir="rtl"] .ms-auto { margin-right: auto; }
[dir="ltr"] .ms-auto { margin-left: auto; }
[dir="rtl"] .me-auto { margin-left: auto; }
[dir="ltr"] .me-auto { margin-right: auto; }

/* ============================================================
   📝 Typography
   ============================================================ */
h1, h2, h3, h4, h5, h6 {
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    margin-bottom: var(--space-4);
}

h1 { font-size: var(--font-size-3xl); }
h2 { font-size: var(--font-size-2xl); }
h3 { font-size: var(--font-size-xl); }
h4 { font-size: var(--font-size-lg); }

p { margin-bottom: var(--space-3); }

a {
    color: var(--primary);
    text-decoration: none;
    transition: color var(--transition-fast);
}
a:hover { color: var(--primary-dark); text-decoration: underline; }

.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-base { font-size: var(--font-size-base); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-2xl { font-size: var(--font-size-2xl); }
.text-3xl { font-size: var(--font-size-3xl); }

.font-normal { font-weight: var(--font-weight-normal); }
.font-medium { font-weight: var(--font-weight-medium); }
.font-semibold { font-weight: var(--font-weight-semibold); }
.font-bold { font-weight: var(--font-weight-bold); }
.font-extrabold { font-weight: var(--font-weight-extrabold); }

.text-center { text-align: center; }
.text-right { text-align: right; }
.text-left { text-align: left; }

.text-muted { color: var(--text-light); }
.text-primary { color: var(--primary); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }

/* ============================================================
   📐 Layout
   ============================================================ */
.container {
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
}

.row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
}

.col { flex: 1; }
.col-2 { flex: 0 0 50%; }
.col-3 { flex: 0 0 33.333%; }
.col-4 { flex: 0 0 25%; }

.grid { display: grid; gap: var(--space-4); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }

/* ============================================================
   🧩 Components - Cards
   ============================================================ */
.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
}
.card:hover {
    box-shadow: var(--shadow-md);
}
.card-flat {
    box-shadow: none;
}
.card-elevated {
    box-shadow: var(--shadow-md);
    border: none;
}
.card-interactive {
    cursor: pointer;
}
.card-interactive:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}
.card-interactive:active {
    transform: scale(0.98);
}

/* ============================================================
   🧩 Components - Buttons
   ============================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 10px 20px;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
    line-height: 1.4;
    user-select: none;
}
.btn:hover { opacity: 0.9; transform: translateY(-1px); }
.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover { background: var(--primary-dark); }
.btn-success { background: var(--success); color: white; }
.btn-danger { background: var(--danger); color: white; }
.btn-outline { background: transparent; border-color: var(--primary); color: var(--primary); }
.btn-outline:hover { background: var(--primary); color: white; }
.btn-ghost { background: transparent; color: var(--primary); }
.btn-ghost:hover { background: var(--primary-bg); }

.btn-sm { padding: 6px 12px; font-size: var(--font-size-xs); }
.btn-lg { padding: 14px 28px; font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); }
.btn-block { width: 100%; display: flex; }
.btn-icon {
    width: 40px; height: 40px; padding: 0; border-radius: 50%;
    font-size: var(--font-size-lg);
}

/* ============================================================
   🧩 Components - Badges
   ============================================================ */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
}
.badge-success { background: var(--success-bg); color: var(--success); }
.badge-danger { background: var(--danger-bg); color: var(--danger); }
.badge-warning { background: var(--warning-bg); color: var(--warning); }
.badge-info { background: var(--info-bg); color: var(--info); }
.badge-primary { background: var(--primary-bg); color: var(--primary); }

/* ============================================================
   🧩 Components - Forms
   ============================================================ */
.input {
    width: 100%;
    padding: 10px 14px;
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    color: var(--text);
    background: var(--surface);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    outline: none;
}
.input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}
.input::placeholder { color: var(--text-muted); }
.input:disabled { background: var(--bg-secondary); opacity: 0.7; }

.input-group {
    position: relative;
    margin-bottom: var(--space-3);
}
.input-group .input-icon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    font-size: var(--font-size-lg);
    pointer-events: none;
}
[dir="rtl"] .input-group .input-icon { right: 12px; }
[dir="ltr"] .input-group .input-icon { left: 12px; }
[dir="rtl"] .input-group .input { padding-right: 40px; }
[dir="ltr"] .input-group .input { padding-left: 40px; }

select.input { appearance: none; cursor: pointer; }
textarea.input { resize: vertical; min-height: 80px; }

.checkbox, .radio {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
}

/* ============================================================
   🧩 Components - Tables
   ============================================================ */
.table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
}
.table th {
    text-align: right;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-secondary);
    border-bottom: 2px solid var(--border);
    font-weight: var(--font-weight-semibold);
    color: var(--text-secondary);
}
.table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-light);
    color: var(--text);
}
.table tbody tr:hover { background: var(--surface-hover); }

/* ============================================================
   🧩 Components - Navigation
   ============================================================ */
.bottom-nav {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border-top: 1px solid var(--border);
    height: var(--bottom-nav-height);
    position: sticky;
    bottom: 0;
    z-index: var(--z-sticky);
}
.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 10px;
    color: var(--text-light);
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    transition: color var(--transition-fast);
}
.nav-item .nav-icon { font-size: 22px; }
.nav-item.active { color: var(--primary); font-weight: var(--font-weight-bold); }

.top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    height: var(--header-height);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
}

/* ============================================================
   🧩 Components - Chat
   ============================================================ */
.chat-bubble {
    padding: 10px 14px;
    border-radius: 16px;
    margin-bottom: var(--space-2);
    max-width: 80%;
    font-size: var(--font-size-sm);
    line-height: 1.5;
    word-break: break-word;
    position: relative;
}
.chat-sent {
    background: var(--primary);
    color: white;
    margin-right: auto;
    border-bottom-left-radius: 4px;
}
.chat-received {
    background: var(--bg-secondary);
    color: var(--text);
    margin-left: auto;
    border-bottom-right-radius: 4px;
}
.chat-time {
    font-size: 10px;
    opacity: 0.7;
    margin-top: 4px;
}

/* ============================================================
   🧩 Components - Timeline
   ============================================================ */
.timeline { position: relative; }
.timeline-item {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--font-size-sm);
}
.timeline-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--primary);
    margin-top: 4px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
}
.timeline-item:not(:last-child) .timeline-dot::after {
    content: '';
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: calc(100% + var(--space-4));
    background: var(--border);
}

/* ============================================================
   🧩 Components - Progress
   ============================================================ */
.progress {
    background: var(--border-light);
    height: 8px;
    border-radius: var(--radius-full);
    overflow: hidden;
}
.progress-bar {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width var(--transition);
}
.progress-primary { background: var(--primary); }
.progress-success { background: var(--success); }
.progress-danger { background: var(--danger); }

/* ============================================================
   🧩 Components - Toast
   ============================================================ */
.toast {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: white;
    box-shadow: var(--shadow-md);
}
.toast-success { background: var(--success); }
.toast-danger { background: var(--danger); }
.toast-warning { background: var(--warning); color: var(--text); }

/* ============================================================
   🧩 Components - Skeleton Loading
   ============================================================ */
.skeleton {
    background: linear-gradient(90deg, 
        var(--border-light) 25%, 
        var(--border) 50%, 
        var(--border-light) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite;
    border-radius: var(--radius-sm);
    height: 16px;
}
.skeleton-text { height: 14px; width: 80%; }
.skeleton-avatar { width: 48px; height: 48px; border-radius: 50%; }
.skeleton-card { height: 100px; }

@keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

/* ============================================================
   🧩 Components - Connection Status
   ============================================================ */
.connection-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
}
.connection-status.connected { background: var(--success-bg); color: var(--success); }
.connection-status.disconnected { background: var(--danger-bg); color: var(--danger); }
.status-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.status-dot-green { background: var(--success); animation: pulse 2s infinite; }
.status-dot-red { background: var(--danger); }

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
}

/* ============================================================
   🧩 Components - OTP Inputs
   ============================================================ */
.otp-inputs {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
}
.otp-inputs input {
    width: 48px; height: 56px;
    text-align: center;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    color: var(--text);
    background: var(--surface);
    transition: border-color var(--transition-fast);
}
.otp-inputs input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

/* ============================================================
   🧩 Components - Modal
   ============================================================ */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: var(--z-modal);
}
.modal {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    max-width: 480px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: var(--shadow-xl);
}

/* ============================================================
   📱 PWA / Install Banner
   ============================================================ */
.install-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--primary);
    color: white;
    border-radius: var(--radius);
    font-size: var(--font-size-sm);
    box-shadow: var(--shadow-md);
}

/* ============================================================
   🔔 Notifications
   ============================================================ */
.notification-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--border-light);
    transition: background var(--transition-fast);
}
.notification-item:hover { background: var(--surface-hover); }
.notification-item.unread { background: var(--primary-bg); }

/* ============================================================
   📱 Responsive Design
   ============================================================ */

/* Tablet */
@media (max-width: 1024px) {
    :root {
        --container-max: 100%;
    }
    .grid-4 { grid-template-columns: repeat(3, 1fr); }
    .col-4 { flex: 0 0 33.333%; }
}

/* Mobile Landscape */
@media (max-width: 768px) {
    :root {
        --header-height: 52px;
        --bottom-nav-height: 56px;
        --space-4: 0.75rem;
    }
    
    .grid-2, .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
    .col-2, .col-3, .col-4 { flex: 0 0 50%; }
    .hide-mobile { display: none !important; }
    
    .card { padding: var(--space-4); }
    .btn { padding: 8px 16px; }
}

/* Mobile Portrait */
@media (max-width: 480px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    .col-2, .col-3, .col-4 { flex: 0 0 100%; }
    
    h1 { font-size: var(--font-size-2xl); }
    h2 { font-size: var(--font-size-xl); }
    
    .container { padding: 0 var(--space-4); }
    .modal { width: 95%; padding: var(--space-4); }
}

/* ============================================================
   🖨️ Print Styles
   ============================================================ */
@media print {
    .bottom-nav, .top-nav, .btn, .no-print { display: none !important; }
    body { background: white; }
    .card { box-shadow: none; border: 1px solid #ddd; }
}

/* ============================================================
   ♿ Accessibility
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}

.sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); border: 0;
}

:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

/* ============================================================
   🛠️ Utility Classes
   ============================================================ */
.hidden { display: none !important; }
.block { display: block; }
.inline { display: inline; }

.w-full { width: 100%; }
.h-full { height: 100%; }

.m-0 { margin: 0; }
.mt-0 { margin-top: 0; } .mt-2 { margin-top: var(--space-2); }
.mt-3 { margin-top: var(--space-3); } .mt-4 { margin-top: var(--space-4); }
.mt-6 { margin-top: var(--space-6); } .mt-8 { margin-top: var(--space-8); }
.mb-0 { margin-bottom: 0; } .mb-2 { margin-bottom: var(--space-2); }
.mb-3 { margin-bottom: var(--space-3); } .mb-4 { margin-bottom: var(--space-4); }
.mb-6 { margin-bottom: var(--space-6); } .mb-8 { margin-bottom: var(--space-8); }

.p-0 { padding: 0; } .p-2 { padding: var(--space-2); }
.p-3 { padding: var(--space-3); } .p-4 { padding: var(--space-4); }
.p-6 { padding: var(--space-6); }

.rounded-sm { border-radius: var(--radius-sm); }
.rounded { border-radius: var(--radius); }
.rounded-full { border-radius: var(--radius-full); }

.shadow-none { box-shadow: none; }
.shadow { box-shadow: var(--shadow); }
.shadow-md { box-shadow: var(--shadow-md); }

.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }

.relative { position: relative; }
.absolute { position: absolute; }
.sticky { position: sticky; top: 0; }

.cursor-pointer { cursor: pointer; }
.select-none { user-select: none; }

.opacity-50 { opacity: 0.5; }
.opacity-75 { opacity: 0.75; }

.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
